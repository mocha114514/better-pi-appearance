{
  "name": "mpep-extensions",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "MPEP's personal extension suite for Pi",
  "dependencies": {
    "https-proxy-agent": "7.0.6",
    "import-meta-resolve": "4.2.0",
    "jsonc-parser": "3.3.1",
    "openai": "6.40.0",
    "ws": "8.21.3"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./language.ts",
      "./manager/index.ts",
      "./turn-fold/index.ts",
      "./markdown-enhancer/index.ts",
      "./terminal-interaction/index.ts",
      "./turn-navigator/index.ts",
      "./path-links/index.ts",
      "./cooking-timer.ts",
      "./list/index.ts",
      "./statusline.ts",
      "./tps.ts",
      "./turn-notify/index.ts",
      "./theme-distributor.ts",
      "./usage/index.ts",
      "./compact-forewarn/index.ts",
      "./subagent/index.ts",
      "./export/index.ts",
      "./stderr-guard/index.ts",
      "./user-bubble/index.ts",
      "./responses-ws/index.ts"
